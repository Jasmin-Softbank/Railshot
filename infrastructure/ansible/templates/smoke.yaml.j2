apiVersion: v1
kind: Namespace
metadata:
  name: k3s-smoke
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: k3s-smoke
spec:
  replicas: 1
  selector:
    matchLabels:
      app: smoke-web
  template:
    metadata:
      labels:
        app: smoke-web
    spec:
      automountServiceAccountToken: false
      containers:
        - name: web
          image: {{ smoke_test_image | to_json }}
          ports:
            - containerPort: 80
          resources:
            requests:
              cpu: 25m
              memory: 32Mi
            limits:
              cpu: 200m
              memory: 96Mi
          securityContext:
            allowPrivilegeEscalation: false
            seccompProfile:
              type: RuntimeDefault
          readinessProbe:
            httpGet:
              path: /
              port: 80
            initialDelaySeconds: 2
            periodSeconds: 3
          livenessProbe:
            httpGet:
              path: /
              port: 80
            initialDelaySeconds: 10
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: k3s-smoke
spec:
  type: NodePort
  selector:
    app: smoke-web
  ports:
    - port: 80
      targetPort: 80
      nodePort: {{ smoke_node_port | int }}
