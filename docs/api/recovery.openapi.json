  "components": {
    "securitySchemes": {
      "mutualTLS": {
        "type": "mutualTLS",
        "description": "CA verification plus exact certificate fingerprint environment/role registry"
      }
    },
    "schemas": {
      "Escrow": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "environment_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "vault-initialization",
              "vault-delivery-approle"
            ]
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "material": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Initialization"
              },
              {
                "$ref": "#/components/schemas/AppRole"
              }
            ]
          }
        },
        "required": [
          "version",
          "environment_id",
          "kind",
          "material"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "vault-initialization"
                }
              }
            },
            "then": {
              "properties": {
                "material": {
                  "$ref": "#/components/schemas/Initialization"
                }
              }
            },
            "else": {
              "properties": {
                "material": {
                  "$ref": "#/components/schemas/AppRole"
                }
              }
            }
          }
        ]
      },
      "Initialization": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "root_token": {
            "type": "string",
            "minLength": 8,
            "maxLength": 4096,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "recovery_keys_b64": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "contentEncoding": "base64",
              "description": "Exactly 33 decoded bytes"
            }
          },
          "recovery_keys_hex": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{66}$"
            }
          },
          "recovery_keys_shares": {
            "const": 5,
            "type": "integer"
          },
          "recovery_keys_threshold": {
            "const": 3,
            "type": "integer"
          },
          "unseal_keys_b64": {
            "type": "array",
            "maxItems": 0
          },
          "unseal_keys_hex": {
            "type": "array",
            "maxItems": 0
          },
          "unseal_shares": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "unseal_threshold": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        },
        "required": [
          "root_token",
          "recovery_keys_b64"
        ],
        "oneOf": [
          {
            "properties": {
              "unseal_shares": {
                "const": 0
              },
              "unseal_threshold": {
                "const": 0
              }
            }
          },
          {
            "properties": {
              "unseal_shares": {
                "const": 1
              },
              "unseal_threshold": {
                "const": 1
              }
            },
            "required": [
              "unseal_shares",
              "unseal_threshold",
              "unseal_keys_b64",
              "unseal_keys_hex",
              "recovery_keys_shares",
              "recovery_keys_threshold"
            ]
          }
        ]
      },
      "AppRole": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "secret_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        },
        "required": [
          "role_id",
          "secret_id"
        ]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stored": {
            "const": true,
            "type": "boolean"
          },
          "receipt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "required": [
          "stored",
          "receipt_id"
        ]
      },
      "Envelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "environment_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "vault-initialization",
              "vault-delivery-approle"
            ]
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "receipt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "purpose": {
            "enum": [
              "initialization-resume",
              "delivery-handoff"
            ]
          },
          "recipient_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "wrapped_key": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "nonce": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "ciphertext": {
            "type": "string",
            "contentEncoding": "base64"
          }
        },
        "required": [
          "version",
          "environment_id",
          "kind",
          "operation_id",
          "receipt_id",
          "purpose",
          "recipient_fingerprint",
          "wrapped_key",
          "nonce",
          "ciphertext"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "retryable": {
                "type": "boolean"
              },
              "outcome_unknown": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "request_id",
              "retryable",
              "outcome_unknown"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
