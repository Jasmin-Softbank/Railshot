{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "RAILSHOT operator Ansible jobs API",
    "version": "1.1.0",
    "description": "Internal Ansible integration contract for infrastructure/ansible/api.py. Approved AWS/GCP descriptors or OpenStack GET ServerResponse snapshots are resolved on the server. Typed parameters map to inventory and existing playbook variables. Plain HTTP on IPv4 loopback only; upstream service owns user/project authorization and resource creation. Validation does not contact guests or prove readiness. Database configuration is planning-only; the provided HA playbook is not connected to this API. This static specification is not served by the API. Unsupported methods use the standard-library non-JSON 501 response."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "description": "Host must occur exactly once and equal 127.0.0.1:<port> or localhost:<port>. Origin must be absent or occur exactly once and equal http://127.0.0.1:<port> or http://localhost:<port>. No CORS/preflight support. Forwarded headers do not alter these checks.",
      "variables": {
        "port": {
          "default": "4180",
          "description": "Configured local server port (CLI range 1..65535)."
        }
      }
    }
  ],
  "security": [
    {
      "operatorBearer": []
    }
  ],
  "paths": {
    "/v1/ansible/validate": {
      "post": {
        "operationId": "validateAnsibleInput",
        "summary": "Resolve approved targets and preview inventory and variables without execution",
        "description": "Synchronous input validation only: no SSH, provider call, job record or remote mutation. Reads approved provider snapshots; it does not refresh them or verify ownership independently. Request IDs on this endpoint are not reserved.",
        "parameters": [
          {
            "name": "Content-Length",
            "in": "header",
            "required": true,
            "description": "Exactly one header; one to five ASCII decimal digits; total encoded body size must be 1..8192 bytes. Chunked/Transfer-Encoding requests are rejected.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              },
              "example": {
                "request_id": "db-plan-001",
                "target_id": "db-onprem",
                "operation": "database.configure",
                "parameters": {
                  "mode": "standalone",
                  "nodes": [
                    {
                      "target_id": "db-onprem",
                      "roles": [
                        "database"
                      ]
                    }
                  ],
                  "placements": [
                    {
                      "provider": "openstack",
                      "site": "onprem-a",
                      "database_nodes": 1,
                      "dcs_voters": 0
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "$ref": "#/paths/~1v1~1ansible~1jobs/post/responses/400"
          },
          "401": {
            "$ref": "#/paths/~1v1~1ansible~1jobs/post/responses/401"
          },
          "403": {
            "$ref": "#/paths/~1v1~1ansible~1jobs/post/responses/403"
          },
          "404": {
            "$ref": "#/paths/~1v1~1ansible~1jobs/post/responses/404"
          },
          "411": {
            "$ref": "#/paths/~1v1~1ansible~1jobs/post/responses/411"
          },
          "413": {
            "$ref": "#/paths/~1v1~1ansible~1jobs/post/responses/413"
          },
          "415": {
            "$ref": "#/paths/~1v1~1ansible~1jobs/post/responses/415"
          },
          "503": {
            "$ref": "#/paths/~1v1~1ansible~1jobs/post/responses/503"
          },
          "200": {
            "description": "Input and approved target mappings are valid. Inspect execution_supported and blockers separately. A valid DB plan still has execution_supported=false.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ansible/jobs": {
      "post": {
        "operationId": "submitAnsibleJob",
        "summary": "Submit or retrieve a registered target job",
        "description": "Accept guest.check or runtime.install after validating the approved target and operation parameters. database.configure is validated but returns 501 without creating a job. The request ID binds all expanded server-side inputs, including typed parameters, resource/SSH configuration and timeout. Matching retries return the current/stored job. Changed input returns 409; uncertain remote work is never retried automatically. Query strings and a trailing slash are unsupported.",
        "parameters": [
          {
            "name": "Content-Length",
            "in": "header",
            "required": true,
            "description": "Exactly one header; one to five ASCII decimal digits; total encoded body size must be 1..8192 bytes. Chunked/Transfer-Encoding requests are rejected.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              },
              "example": {
                "request_id": "openapi-runtime-001",
                "target_id": "demo-aws",
                "operation": "runtime.install"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An existing request with the same expanded server-side input has a stored non-active status (succeeded, failed, blocked or unknown). Returns that job without starting another executor.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "202": {
            "description": "A new job was durably recorded before executor dispatch, or the same request is already queued/running. One worker is allowed; this is not an unbounded queue.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              },
              "Location": {
                "description": "Relative status URL for this request.",
                "schema": {
                  "type": "string",
                  "pattern": "^/v1/ansible/jobs/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                }
              },
              "Retry-After": {
                "description": "Suggested delay before polling the Location URL, in seconds.",
                "schema": {
                  "type": "string",
                  "const": "2"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_JSON, INVALID_JOB_REQUEST (including parameters for another operation, duplicate DB roles or placement count mismatch), or TARGET_PURPOSE_MISMATCH.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                },
                "example": {
                  "error": {
                    "code": "INVALID_JOB_REQUEST"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "TARGET_NOT_REGISTERED for an unknown target. An unsupported GET/POST path instead returns NOT_FOUND after authentication.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                },
                "example": {
                  "error": {
                    "code": "TARGET_NOT_REGISTERED"
                  }
                }
              }
            }
          },
          "409": {
            "description": "REQUEST_ID_CONFLICT for changed expanded input; EXECUTOR_BUSY for another active job; TARGET_RECONCILE_REQUIRED for unresolved prior work on this target.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                },
                "example": {
                  "error": {
                    "code": "TARGET_RECONCILE_REQUIRED"
                  }
                }
              }
            }
          },
          "411": {
            "description": "CONTENT_LENGTH_REQUIRED: exactly one Content-Length header with one to five ASCII decimal digits is required.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                },
                "example": {
                  "error": {
                    "code": "CONTENT_LENGTH_REQUIRED"
                  }
                }
              }
            }
          },
          "413": {
            "description": "REQUEST_TOO_LARGE: body length is zero or greater than 8192 bytes.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                },
                "example": {
                  "error": {
                    "code": "REQUEST_TOO_LARGE"
                  }
                }
              }
            }
          },
          "415": {
            "description": "JSON_BODY_REQUIRED: Content-Type must be application/json; a non-empty Transfer-Encoding header is rejected.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                },
                "example": {
                  "error": {
                    "code": "JSON_BODY_REQUIRED"
                  }
                }
              }
            }
          },
          "503": {
            "description": "TARGET_CONFIGURATION_INVALID, EXECUTOR_UNAVAILABLE or API_UNAVAILABLE. The operator must inspect server-side configuration/state; this response does not establish a safe retry.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                },
                "example": {
                  "error": {
                    "code": "API_UNAVAILABLE"
                  }
                }
              }
            }
          },
          "501": {
            "description": "DATABASE_PLAYBOOK_UNAVAILABLE: valid database.configure input, but no installation is admitted or executed.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                },
                "example": {
                  "error": {
                    "code": "DATABASE_PLAYBOOK_UNAVAILABLE"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/ansible/jobs/{request_id}": {
      "get": {
        "operationId": "getAnsibleJob",
        "summary": "Read a job and reconcile available native completion evidence",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RequestId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current job, including failed, blocked and unknown outcomes. A non-active interrupted job may be reconciled against matching native completion evidence; GET never dispatches an executor.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "JOB_NOT_FOUND for an absent request. Malformed IDs, query strings, trailing slashes and other unsupported GET/POST paths return NOT_FOUND after authentication.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                },
                "example": {
                  "error": {
                    "code": "JOB_NOT_FOUND"
                  }
                }
              }
            }
          },
          "503": {
            "description": "API_UNAVAILABLE: a server-side read or reconciliation failure.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                },
                "example": {
                  "error": {
                    "code": "API_UNAVAILABLE"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "operatorBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Operator token read from an owner-only local file, 32..512 ASCII characters matching [A-Za-z0-9._~-]. Opaque shared token, not JWT or OAuth. Send exactly one Authorization header with the case-sensitive Bearer prefix; comparison is constant-time."
      }
    },
    "headers": {
      "NoStore": {
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      },
      "NoSniff": {
        "schema": {
          "type": "string",
          "const": "nosniff"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "UNAUTHORIZED: exactly one Authorization header with the exact Bearer prefix and matching operator token is required.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/NoSniff"
          },
          "WWW-Authenticate": {
            "schema": {
              "type": "string",
              "const": "Bearer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HTTPError"
            },
            "example": {
              "error": {
                "code": "UNAUTHORIZED"
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "HOST_NOT_ALLOWED or ORIGIN_NOT_ALLOWED. Host and Origin checks run before token authentication.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/NoSniff"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HTTPError"
            },
            "example": {
              "error": {
                "code": "HOST_NOT_ALLOWED"
              }
            }
          }
        }
      }
    },
    "schemas": {
      "RequestId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "Operation": {
        "type": "string",
        "enum": [
          "guest.check",
          "runtime.install"
        ]
      },
      "JobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "target_id",
          "operation"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "operation": {
            "type": "string",
            "enum": [
              "guest.check",
              "runtime.install",
              "database.configure"
            ]
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "wait_timeout_seconds": {
                "type": "integer",
                "minimum": 30,
                "maximum": 600
              },
              "mode": {
                "type": "string",
                "enum": [
                  "standalone",
                  "patroni"
                ]
              },
              "nodes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "target_id",
                    "roles"
                  ],
                  "properties": {
                    "target_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63,
                      "pattern": "^[a-z][a-z0-9-]{0,62}$"
                    },
                    "roles": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 2,
                      "items": {
                        "type": "string",
                        "enum": [
                          "database",
                          "dcs"
                        ]
                      }
                    }
                  }
                }
              },
              "placements": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "provider",
                    "site",
                    "database_nodes",
                    "dcs_voters"
                  ],
                  "properties": {
                    "provider": {
                      "type": "string",
                      "enum": [
                        "aws",
                        "gcp",
                        "openstack",
                        "onprem"
                      ]
                    },
                    "site": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63,
                      "pattern": "^[a-z0-9][a-z0-9._-]*$"
                    },
                    "database_nodes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 16
                    },
                    "dcs_voters": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 16
                    }
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "guest.check"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {}
                }
              }
            },
            "else": {}
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "runtime.install"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "wait_timeout_seconds": {}
                  }
                }
              }
            },
            "else": {}
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "database.configure"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {},
                    "nodes": {},
                    "placements": {}
                  },
                  "required": [
                    "mode",
                    "nodes",
                    "placements"
                  ]
                }
              },
              "required": [
                "parameters"
              ]
            },
            "else": {}
          }
        ]
      },
      "JobError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "outcome_unknown"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z_]{1,64}$"
          },
          "outcome_unknown": {
            "type": "boolean",
            "description": "True means the remote outcome has not been established; do not blindly retry."
          }
        }
      },
      "JobResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "guest_ready",
          "runtime_ready",
          "application_ready",
          "public_http_verified",
          "replayed",
          "stage"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "succeeded",
              "invalid",
              "blocked",
              "failed"
            ],
            "description": "Native executor status. invalid maps to outer job status failed; an uncertain error maps to outer status unknown."
          },
          "guest_ready": {
            "type": "boolean"
          },
          "runtime_ready": {
            "type": "boolean"
          },
          "application_ready": {
            "type": "boolean",
            "const": false
          },
          "public_http_verified": {
            "type": "boolean",
            "const": false
          },
          "replayed": {
            "type": "boolean",
            "description": "Copied from the native executor result. Repeating an HTTP POST returns the stored result and does not automatically set this field to true."
          },
          "stage": {
            "type": "string",
            "enum": [
              "validation",
              "executor_preflight",
              "guest",
              "runtime",
              "unknown"
            ]
          }
        }
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "target_id",
          "operation",
          "status",
          "created_at",
          "updated_at",
          "result",
          "error"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "target_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "operation": {
            "$ref": "#/components/schemas/Operation"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "blocked",
              "unknown"
            ]
          },
          "created_at": {
            "type": "number",
            "format": "double",
            "description": "Unix epoch seconds, including fractional seconds."
          },
          "updated_at": {
            "type": "number",
            "format": "double",
            "description": "Unix epoch seconds, including fractional seconds; may change during reconciliation."
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobError"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "description": "A successful job proves only the requested guest/runtime readiness, never application deployment or public HTTP availability."
      },
      "HTTPError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z_]{1,64}$"
              }
            }
          }
        },
        "description": "Request-level error, distinct from Job.error. No native logs, credentials or private filesystem paths are exposed."
      },
      "ValidationResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "valid",
          "operation",
          "target_id",
          "execution_supported",
          "blockers",
          "inventory",
          "variables"
        ],
        "properties": {
          "valid": {
            "type": "boolean",
            "const": true
          },
          "operation": {
            "type": "string",
            "enum": [
              "guest.check",
              "runtime.install",
              "database.configure"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "execution_supported": {
            "type": "boolean"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z_]{1,64}$"
                }
              }
            }
          },
          "inventory": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "all"
            ],
            "properties": {
              "all": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "children"
                ],
                "properties": {
                  "children": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [],
                    "properties": {
                      "k3s_server": {
                        "$ref": "#/components/schemas/InventoryGroup"
                      },
                      "k3s_workers": {
                        "$ref": "#/components/schemas/InventoryGroup"
                      },
                      "database": {
                        "$ref": "#/components/schemas/InventoryGroup"
                      },
                      "dcs": {
                        "$ref": "#/components/schemas/InventoryGroup"
                      }
                    }
                  }
                }
              }
            }
          },
          "variables": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "railshot_request_id",
                  "railshot_target_id",
                  "railshot_resource_id",
                  "railshot_expected_arch",
                  "railshot_initialization",
                  "railshot_node_ip",
                  "k3s_api_host",
                  "k3s_node_name",
                  "k3s_version",
                  "railshot_wait_timeout_seconds"
                ],
                "properties": {
                  "railshot_request_id": {
                    "type": "string"
                  },
                  "railshot_target_id": {
                    "type": "string"
                  },
                  "railshot_resource_id": {
                    "type": "string"
                  },
                  "railshot_expected_arch": {
                    "type": "string"
                  },
                  "railshot_initialization": {
                    "type": "string"
                  },
                  "railshot_node_ip": {
                    "type": "string"
                  },
                  "k3s_api_host": {
                    "type": "string"
                  },
                  "k3s_node_name": {
                    "type": "string"
                  },
                  "k3s_version": {
                    "type": "string"
                  },
                  "railshot_wait_timeout_seconds": {
                    "type": "integer",
                    "minimum": 30,
                    "maximum": 600
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "railshot_database"
                ],
                "properties": {
                  "railshot_database": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode",
                      "port",
                      "placements"
                    ],
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "standalone",
                          "patroni"
                        ]
                      },
                      "port": {
                        "type": "integer",
                        "const": 5432
                      },
                      "placements": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 16,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "provider",
                            "site",
                            "database_nodes",
                            "dcs_voters"
                          ],
                          "properties": {
                            "provider": {
                              "type": "string",
                              "enum": [
                                "aws",
                                "gcp",
                                "openstack",
                                "onprem"
                              ]
                            },
                            "site": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 63,
                              "pattern": "^[a-z0-9][a-z0-9._-]*$"
                            },
                            "database_nodes": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 16
                            },
                            "dcs_voters": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 16
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "description": "Safe inventory/variable summary without SSH paths, credentials or local runtime receipt paths. execution_supported means an adapter exists, not that connectivity or guest readiness was observed. DB variables are an integration handoff proposal; the provided HA playbook is not connected to this API."
      },
      "InventoryGroup": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hosts"
        ],
        "properties": {
          "hosts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ansible_host",
                "railshot_resource_id",
                "railshot_provider",
                "railshot_site"
              ],
              "properties": {
                "ansible_host": {
                  "type": "string",
                  "format": "ipv4"
                },
                "railshot_resource_id": {
                  "type": "string"
                },
                "railshot_provider": {
                  "type": "string",
                  "enum": [
                    "aws",
                    "gcp",
                    "openstack",
                    "onprem"
                  ]
                },
                "railshot_site": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
