{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "railshot-dashboard",
        "namespace": "railshot-system"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "railshot-dashboard"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "railshot-dashboard",
              "railshot.io/api-client": "true"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/arch": "amd64",
              "railshot.io/node-role": "platform"
            },
            "imagePullSecrets": [
              {
                "name": "ghcr-pull"
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 101,
              "runAsGroup": 101,
              "fsGroup": 101,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "dashboard",
                "image": "ghcr.io/jasmin-softbank/railshot-dashboard@sha256:5ef1526e804416720d3e748859cf4d04d74c1bd80d4978f2c4cd0ac5eec43dde",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "api-token",
                    "mountPath": "/run/secrets/api",
                    "readOnly": true
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  }
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "initialDelaySeconds": 10
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              },
              {
                "name": "api-token",
                "secret": {
                  "secretName": "railshot-api",
                  "defaultMode": 288
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "railshot-dashboard",
        "namespace": "railshot-system"
      },
      "spec": {
        "type": "NodePort",
        "selector": {
          "app": "railshot-dashboard"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": "http",
            "nodePort": 31080
          }
        ],
        "externalTrafficPolicy": "Local"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "railshot-api",
        "namespace": "railshot-system"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "railshot-api"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "railshot-api"
            }
          },
          "spec": {
            "serviceAccountName": "railshot-product",
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/arch": "amd64",
              "railshot.io/node-role": "platform"
            },
            "imagePullSecrets": [
              {
                "name": "ghcr-pull"
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "fsGroup": 1000,
              "fsGroupChangePolicy": "OnRootMismatch",
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "initContainers": [
              {
                "name": "private-config",
                "image": "ghcr.io/jasmin-softbank/railshot-api@sha256:0449609b8e80bc1755e93552f9e6e3a339454c06bb765af70939961ab59f9aad",
                "command": [
                  "node",
                  "/app/apps/api/prepare-state.js"
                ],
                "env": [
                  {
                    "name": "GITHUB_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "railshot-github",
                        "key": "token"
                      }
                    }
                  },
                  {
                    "name": "HOME",
                    "value": "/var/lib/railshot"
                  },
                  {
                    "name": "RAILSHOT_OBSERVER_PRODUCT_FILE",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "railshot-environments",
                        "key": "observer_file",
                        "optional": true
                      }
                    }
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "25m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "state",
                    "mountPath": "/var/lib/railshot"
                  },
                  {
                    "name": "config",
                    "mountPath": "/run/config",
                    "readOnly": true
                  },
                  {
                    "name": "dns-config",
                    "mountPath": "/run/dns",
                    "readOnly": true
                  }
                ]
              }
            ],
            "containers": [
              {
                "name": "api",
                "image": "ghcr.io/jasmin-softbank/railshot-api@sha256:0449609b8e80bc1755e93552f9e6e3a339454c06bb765af70939961ab59f9aad",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 4173
                  }
                ],
                "env": [
                  {
                    "name": "RAILSHOT_BIND_HOST",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "RAILSHOT_ALLOWED_HOSTS",
                    "value": "localhost,127.0.0.1,railshot.io,railshot-api,railshot-api.railshot-system.svc.cluster.local"
                  },
                  {
                    "name": "RAILSHOT_ALLOWED_ORIGINS",
                    "value": "https://railshot.io"
                  },
                  {
                    "name": "RAILSHOT_API_TOKEN_FILE",
                    "value": "/run/secrets/api/token"
                  },
                  {
                    "name": "RAILSHOT_STATE_DIR",
                    "value": "/var/lib/railshot/state"
                  },
                  {
                    "name": "RAILSHOT_CD_CONFIG",
                    "value": "/var/lib/railshot/config/cd.json"
                  },
                  {
                    "name": "RAILSHOT_APPLICATIONS_FILE",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "railshot-environments",
                        "key": "applications_file",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "RAILSHOT_OBSERVER_CONFIG",
                    "value": "/var/lib/railshot/config/observer.json"
                  },
                  {
                    "name": "RAILSHOT_OBSERVER_PRODUCT_FILE",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "railshot-environments",
                        "key": "observer_file",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "RAILSHOT_PROFILES_FILE",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "railshot-environments",
                        "key": "profiles_file",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "KUBECONFIG",
                    "value": "/var/lib/railshot/config/kubeconfig"
                  },
                  {
                    "name": "HOME",
                    "value": "/var/lib/railshot"
                  },
                  {
                    "name": "TMPDIR",
                    "value": "/var/lib/railshot/tmp"
                  },
                  {
                    "name": "TF_PLUGIN_CACHE_DIR",
                    "value": "/var/lib/railshot/provider-cache"
                  },
                  {
                    "name": "AWS_REGION",
                    "value": "ap-northeast-2"
                  },
                  {
                    "name": "AWS_DEFAULT_REGION",
                    "value": "ap-northeast-2"
                  },
                  {
                    "name": "AWS_EC2_METADATA_V1_DISABLED",
                    "value": "true"
                  },
                  {
                    "name": "GOOGLE_APPLICATION_CREDENTIALS",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "railshot-environments",
                        "key": "google_credentials_file",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "railshot-environments",
                        "key": "google_credentials_file",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "GITHUB_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "railshot-github",
                        "key": "token"
                      }
                    }
                  },
                  {
                    "name": "GITHUB_OWNER",
                    "value": "Jasmin-Softbank"
                  },
                  {
                    "name": "GITHUB_REPO",
                    "value": "railshot-apps"
                  },
                  {
                    "name": "GITHUB_REF",
                    "value": "main"
                  },
                  {
                    "name": "GITHUB_WORKFLOW",
                    "value": "railshot-deploy.yml"
                  },
                  {
                    "name": "RAILSHOT_TENANT",
                    "value": "demo"
                  },
                  {
                    "name": "RAILSHOT_TARGET_ID",
                    "value": "k3s-aws"
                  },
                  {
                    "name": "RAILSHOT_TARGET_PROVIDER",
                    "value": "aws"
                  },
                  {
                    "name": "RAILSHOT_PROVIDER_TARGETS",
                    "value": "{\"gcp\":\"k3s-gcp\",\"openstack\":\"k3s-openstack\"}"
                  },
                  {
                    "name": "RAILSHOT_TARGET_IDS",
                    "value": "k3s-aws,k3s-gcp,k3s-openstack"
                  },
                  {
                    "name": "RAILSHOT_POD_TEMPLATE_ID",
                    "value": "5a1a75a2abe6fe1378e31e567c79232559d620e03ac87306c798d18d6b534531"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "api-token",
                    "mountPath": "/run/secrets/api",
                    "readOnly": true
                  },
                  {
                    "name": "state",
                    "mountPath": "/var/lib/railshot"
                  },
                  {
                    "name": "kubernetes-api",
                    "mountPath": "/run/railshot-kubernetes",
                    "readOnly": true
                  }
                ],
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http",
                    "httpHeaders": [
                      {
                        "name": "Host",
                        "value": "localhost"
                      }
                    ]
                  },
                  "initialDelaySeconds": 10
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "http",
                    "httpHeaders": [
                      {
                        "name": "Host",
                        "value": "localhost"
                      }
                    ]
                  },
                  "periodSeconds": 2,
                  "timeoutSeconds": 2,
                  "failureThreshold": 30
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "http",
                    "httpHeaders": [
                      {
                        "name": "Host",
                        "value": "localhost"
                      }
                    ]
                  },
                  "periodSeconds": 2,
                  "timeoutSeconds": 2
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "128Mi"
                }
              },
              {
                "name": "api-token",
                "secret": {
                  "secretName": "railshot-api",
                  "defaultMode": 288
                }
              },
              {
                "name": "config",
                "secret": {
                  "secretName": "railshot-executors",
                  "defaultMode": 288
                }
              },
              {
                "name": "dns-config",
                "secret": {
                  "secretName": "railshot-cloudflare",
                  "defaultMode": 288,
                  "optional": true
                }
              },
              {
                "name": "state",
                "persistentVolumeClaim": {
                  "claimName": "railshot-api"
                }
              },
              {
                "name": "kubernetes-api",
                "projected": {
                  "defaultMode": 288,
                  "sources": [
                    {
                      "serviceAccountToken": {
                        "path": "token",
                        "expirationSeconds": 3600
                      }
                    },
                    {
                      "configMap": {
                        "name": "kube-root-ca.crt",
                        "items": [
                          {
                            "key": "ca.crt",
                            "path": "ca.crt"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "railshot-api",
        "namespace": "railshot-system"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "4Gi"
          }
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "railshot-api-private",
        "namespace": "railshot-system"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "railshot-api"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "railshot.io/api-client": "true"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 4173,
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "railshot-api",
        "namespace": "railshot-system"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "railshot-api"
        },
        "ports": [
          {
            "name": "http",
            "port": 4173,
            "targetPort": "http"
          }
        ]
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "railshot-api-prepare",
        "namespace": "railshot-system",
        "annotations": {
          "argocd.argoproj.io/hook": "PreSync",
          "argocd.argoproj.io/hook-delete-policy": "BeforeHookCreation,HookSucceeded"
        }
      },
      "spec": {
        "backoffLimit": 0,
        "activeDeadlineSeconds": 900,
        "template": {
          "metadata": {
            "labels": {
              "railshot.io/api-client": "true"
            }
          },
          "spec": {
            "restartPolicy": "Never",
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/arch": "amd64",
              "railshot.io/node-role": "platform"
            },
            "affinity": {
              "podAffinity": {
                "requiredDuringSchedulingIgnoredDuringExecution": [
                  {
                    "labelSelector": {
                      "matchLabels": {
                        "app": "railshot-api"
                      }
                    },
                    "topologyKey": "kubernetes.io/hostname"
                  }
                ]
              }
            },
            "imagePullSecrets": [
              {
                "name": "ghcr-pull"
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "fsGroup": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "prepare",
                "image": "ghcr.io/jasmin-softbank/railshot-api@sha256:0449609b8e80bc1755e93552f9e6e3a339454c06bb765af70939961ab59f9aad",
                "command": [
                  "node",
                  "/app/apps/api/src/prepare-release.js"
                ],
                "env": [
                  {
                    "name": "RAILSHOT_API_TOKEN_FILE",
                    "value": "/run/secrets/api/token"
                  },
                  {
                    "name": "RAILSHOT_DESIRED_TEMPLATE_ID",
                    "value": "5a1a75a2abe6fe1378e31e567c79232559d620e03ac87306c798d18d6b534531"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "25m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "100m",
                    "memory": "96Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "api-token",
                    "mountPath": "/run/secrets/api",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "api-token",
                "secret": {
                  "secretName": "railshot-api",
                  "defaultMode": 288
                }
              }
            ]
          }
        }
      }
    }
  ]
}
