{
  "schema_version": "0.2",
  "provider": "aws",
  "environment_id": "railshot-runtime-demo",
  "node": {
    "host": "localhost",
    "ssh_user": "ubuntu"
  },
  "workload": {
    "image": "nginx:1.28.0-alpine",
    "namespace": "railshot-demo",
    "replicas": 1,
    "container_port": 80,
    "health_path": "/",
    "sample_content": true
  },
  "exposure": {
    "type": "nodeport",
    "node_port": 30080
  },
  "runtime": {
    "timeout_seconds": 180,
    "mode": "offline",
    "bundle_path": "/var/tmp/railshot-release-package-test",
    "bundle_sha256": "0772caa341314645645a42e0f41c39936d1ee535679bd38761fde263d6a7a0c3"
  }
}
